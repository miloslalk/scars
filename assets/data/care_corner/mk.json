      {
        "title": "\u0427\u043e\u0432\u0435\u043a\u043e\u0432\u0438 \u043f\u0440\u0430\u0432\u0430",
        "description": "\u0427\u043e\u0432\u0435\u043a\u043e\u0432\u0438\u0442\u0435 \u043f\u0440\u0430\u0432\u0430 \u0432\u0430\u0436\u0430\u0442 \u0437\u0430 \u0441\u0438\u0442\u0435 \u043b\u0443\u0453\u0435, \u0431\u0435\u0437 \u0440\u0430\u0437\u043b\u0438\u043a\u0430 \u043d\u0430 \u0440\u0430\u0437\u043b\u0438\u043a\u0438. \u041a\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043a\u0438: \u0443\u043d\u0438\u0432\u0435\u0440\u0437\u0430\u043b\u043d\u0438, \u043d\u0435\u0434\u0435\u043b\u0438\u0432\u0438, \u0435\u0434\u043d\u0430\u043a\u0432\u0438. \u0423\u043b\u043e\u0433\u0430 \u043d\u0430 \u0434\u0440\u0436\u0430\u0432\u0430\u0442\u0430: \u0434\u0430 \u0433\u0438 \u0437\u0430\u0448\u0442\u0438\u0442\u0438 \u0438 \u043e\u0431\u0435\u0437\u0431\u0435\u0434\u0438.",
        "videos": []
