      {
        "title": "\u0427\u043e\u0432\u0435\u043a\u043e\u0432\u0438 \u043f\u0440\u0430\u0432\u0430 \u043d\u0430 \u043c\u043b\u0430\u0434\u0438\u0442\u0435",
        "description": "\u041c\u043b\u0430\u0434\u0438\u0442\u0435 \u0438\u043c\u0430\u0430\u0442 \u043f\u0440\u0430\u0432\u043e \u0434\u0430 \u0431\u0438\u0434\u0430\u0442 \u0441\u043b\u0443\u0448\u043d\u0430\u0442\u0438, \u0434\u0430 \u0443\u0447\u0435\u0441\u0442\u0432\u0443\u0432\u0430\u0430\u0442 \u0438 \u0434\u0430 \u0431\u0438\u0434\u0430\u0442 \u0437\u0430\u0448\u0442\u0438\u0442\u0435\u043d\u0438. \u041e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435\u0442\u043e \u0437\u0430 \u043f\u0440\u0430\u0432\u0430 \u0441\u043e\u0437\u0434\u0430\u0432\u0430 \u0430\u043a\u0442\u0438\u0432\u043d\u0438 \u0433\u0440\u0430\u0453\u0430\u043d\u0438 \u0438 \u0458\u0430 \u043f\u043e\u0442\u0442\u0438\u043a\u043d\u0443\u0432\u0430 \u0434\u0435\u043c\u043e\u043a\u0440\u0430\u0442\u0438\u0458\u0430\u0442\u0430.",
