{
  "wellbeing": {
    "items": [
      {
        "title": "\u0423\u0442\u0440\u0438\u043d\u0441\u043a\u0430 \u043c\u0435\u0434\u0438\u0442\u0430\u0446\u0438\u0458\u0430",
        "description": "\u0423\u0442\u0440\u0438\u043d\u0441\u043a\u0430\u0442\u0430 \u043c\u0435\u0434\u0438\u0442\u0430\u0446\u0438\u0458\u0430 \u043f\u0440\u0435\u0442\u0441\u0442\u0430\u0432\u0443\u0432\u0430 \u043a\u0440\u0430\u0442\u043a\u0430, \u043d\u043e \u0437\u043d\u0430\u0447\u0430\u0458\u043d\u0430 \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0430 \u043a\u043e\u0458\u0430 \u043f\u043e\u043c\u0430\u0433\u0430 \u0432\u043e \u043d\u0430\u0441\u043e\u0447\u0443\u0432\u0430\u045a\u0435 \u043d\u0430 \u0432\u043d\u0438\u043c\u0430\u043d\u0438\u0435\u0442\u043e, \u0441\u043c\u0438\u0440\u0443\u0432\u0430\u045a\u0435 \u043d\u0430 \u0443\u043c\u043e\u0442 \u0438 \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u043a\u0430 \u0437\u0430 \u0434\u0435\u043d\u043e\u0442. \u041d\u0430\u043c\u0435\u0441\u0442\u043e \u0432\u0435\u0434\u043d\u0430\u0448 \u0434\u0430 \u0441\u0435 \u0432\u043a\u043b\u0443\u0447\u0438\u043c\u0435 \u0432\u043e \u043e\u0431\u0432\u0440\u0441\u043a\u0438\u0442\u0435, \u043c\u0435\u0434\u0438\u0442\u0430\u0446\u0438\u0458\u0430\u0442\u0430 \u043d\u0438 \u0434\u0430\u0432\u0430 \u043f\u0440\u043e\u0441\u0442\u043e\u0440 \u0434\u0430 \u0437\u0430\u043f\u043e\u0447\u043d\u0435\u043c\u0435 \u0441\u043e \u043f\u043e\u0433\u043e\u043b\u0435\u043c\u0430 \u0441\u0432\u0435\u0441\u043d\u043e\u0441\u0442 \u0438 \u0441\u0442\u0430\u0431\u0438\u043b\u043d\u043e\u0441\u0442. \u041e\u0432\u0430\u0430 \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0430 \u0441\u0435 \u0437\u0430\u0441\u043d\u043e\u0432\u0430 \u043d\u0430 \u0438\u0434\u0435\u0458\u0430\u0442\u0430 \u0434\u0435\u043a\u0430 \u0432\u043d\u0438\u043c\u0430\u043d\u0438\u0435\u0442\u043e \u043c\u043e\u0436\u0435 \u0434\u0430 \u0441\u0435 \u0442\u0440\u0435\u043d\u0438\u0440\u0430. \u041a\u043e\u0433\u0430 \u0441\u0432\u0435\u0441\u043d\u043e \u0441\u0435 \u0444\u043e\u043a\u0443\u0441\u0438\u0440\u0430\u043c\u0435 \u043d\u0430 \u0441\u0435\u0433\u0430\u0448\u043d\u0438\u043e\u0442 \u043c\u043e\u043c\u0435\u043d\u0442, \u0443\u0447\u0438\u043c\u0435 \u0434\u0430 \u0433\u0438 \u0437\u0430\u0431\u0435\u043b\u0435\u0436\u0443\u0432\u0430\u043c\u0435 \u043c\u0438\u0441\u043b\u0438\u0442\u0435 \u0438 \u0447\u0443\u0432\u0441\u0442\u0432\u0430\u0442\u0430 \u0431\u0435\u0437 \u0432\u0435\u0434\u043d\u0430\u0448 \u0434\u0430 \u0440\u0435\u0430\u0433\u0438\u0440\u0430\u043c\u0435 \u043d\u0430 \u043d\u0438\u0432.",
        "videoUrl": "https://www.youtube.com/watch?v=K9ZI4bAcbHg"
      },
      {
        "title": "\u0424\u043e\u043a\u0443\u0441\u0438\u0440\u0430\u043d\u043e \u0432\u043d\u0438\u043c\u0430\u043d\u0438\u0435",
        "description": "\u0424\u043e\u043a\u0443\u0441\u0438\u0440\u0430\u043d\u043e\u0442\u043e \u0432\u043d\u0438\u043c\u0430\u043d\u0438\u0435 \u0435 \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e\u0441\u0442 \u0441\u0432\u0435\u0441\u043d\u043e \u0434\u0430 \u0458\u0430 \u043d\u0430\u0441\u043e\u0447\u0438\u043c\u0435 \u043d\u0430\u0448\u0430\u0442\u0430 \u043c\u0435\u043d\u0442\u0430\u043b\u043d\u0430 \u0435\u043d\u0435\u0440\u0433\u0438\u0458\u0430 \u043a\u043e\u043d \u0435\u0434\u043d\u0430 \u0440\u0430\u0431\u043e\u0442\u0430, \u043d\u0430\u043c\u0435\u0441\u0442\u043e \u0434\u0430 \u0441\u0435 \u0440\u0430\u0441\u0444\u0440\u043b\u0430\u043c\u0435 \u043d\u0430 \u043f\u043e\u0432\u0435\u045c\u0435 \u043c\u0438\u0441\u043b\u0438 \u0438\u043b\u0438 \u0441\u0442\u0438\u043c\u0443\u043b\u0438. \u0412\u043e \u0434\u0435\u043d\u0435\u0448\u043d\u043e \u0432\u0440\u0435\u043c\u0435, \u043a\u0430\u0434\u0435 \u0432\u043d\u0438\u043c\u0430\u043d\u0438\u0435\u0442\u043e \u043b\u0435\u0441\u043d\u043e \u0441\u0435 \u0433\u0443\u0431\u0438, \u043e\u0432\u0430\u0430 \u0432\u0435\u0448\u0442\u0438\u043d\u0430 \u0435 \u043e\u0441\u043e\u0431\u0435\u043d\u043e \u0432\u0430\u0436\u043d\u0430. \u041a\u043e\u0433\u0430 \u0432\u043d\u0438\u043c\u0430\u043d\u0438\u0435\u0442\u043e \u045c\u0435 \u201e\u043e\u0434\u043b\u0435\u0442\u0430\u201c, \u0432\u0430\u0436\u043d\u043e \u0435 \u0442\u043e\u0430 \u0434\u0430 \u0441\u0435 \u0437\u0430\u0431\u0435\u043b\u0435\u0436\u0438 \u0431\u0435\u0437 \u0441\u0430\u043c\u043e\u043a\u0440\u0438\u0442\u0438\u043a\u0430 \u0438 \u043d\u0435\u0436\u043d\u043e \u0434\u0430 \u0441\u0435 \u0432\u0440\u0430\u0442\u0438 \u043d\u0430\u0437\u0430\u0434.",
        "videoUrl": "https://youtu.be/m026DWBnNuY?si=oLUIw5zehHjI0EH3"
      },
      {
        "title": "\u041f\u0441\u0438\u0445\u043e\u043b\u043e\u0433\u0438\u0458\u0430 \u043d\u0430 \u0431\u043e\u0438",
        "description": "\u0411\u043e\u0438\u0442\u0435 \u0438\u043c\u0430\u0430\u0442 \u0441\u0438\u043b\u043d\u043e \u0432\u043b\u0438\u0458\u0430\u043d\u0438\u0435 \u0432\u0440\u0437 \u043d\u0430\u0448\u0435\u0442\u043e \u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435, \u043c\u0438\u0441\u043b\u0438 \u0438 \u043f\u0435\u0440\u0446\u0435\u043f\u0446\u0438\u0438. \u0418\u0430\u043a\u043e \u0437\u043d\u0430\u0447\u0435\u045a\u0430\u0442\u0430 \u043d\u0430 \u0431\u043e\u0438\u0442\u0435 \u043c\u043e\u0436\u0435 \u0434\u0430 \u0441\u0435 \u0440\u0430\u0437\u043b\u0438\u043a\u0443\u0432\u0430\u0430\u0442 \u043e\u0434 \u043b\u0438\u0447\u043d\u043e\u0441\u0442 \u0434\u043e \u043b\u0438\u0447\u043d\u043e\u0441\u0442, \u043f\u043e\u0441\u0442\u043e\u0458\u0430\u0442 \u043e\u0434\u0440\u0435\u0434\u0435\u043d\u0438 \u043e\u043f\u0448\u0442\u0438 \u0430\u0441\u043e\u0446\u0438\u0458\u0430\u0446\u0438\u0438. \u0411\u043e\u0438\u0442\u0435 \u043c\u043e\u0436\u0430\u0442 \u0434\u0430 \u0441\u0435 \u043a\u043e\u0440\u0438\u0441\u0442\u0430\u0442 \u043a\u0430\u043a\u043e \u0430\u043b\u0430\u0442\u043a\u0430 \u0437\u0430 \u0441\u0430\u043c\u043e\u0438\u0437\u0440\u0430\u0437\u0443\u0432\u0430\u045a\u0435, \u043e\u0441\u043e\u0431\u0435\u043d\u043e \u043a\u0430\u0458 \u043c\u043b\u0430\u0434\u0438 \u043b\u0443\u0453\u0435 \u043a\u043e\u0438 \u043c\u043e\u0436\u0435\u0431\u0438 \u043f\u043e\u0442\u0435\u0448\u043a\u043e \u0433\u0438 \u0438\u0437\u0440\u0430\u0437\u0443\u0432\u0430\u0430\u0442 \u0447\u0443\u0432\u0441\u0442\u0432\u0430\u0442\u0430 \u0441\u043e \u0437\u0431\u043e\u0440\u043e\u0432\u0438.",
        "videoUrl": "https://youtube.com/shorts/SHpGxhCgAzo?si=Ia33D7oePTmt3t6y"
      },
      {
        "title": "Mindfulness (\u043f\u043e\u043b\u043d\u0430 \u0441\u0432\u0435\u0441\u043d\u043e\u0441\u0442)",
        "description": "Mindfulness \u0435 \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0430 \u043d\u0430 \u0446\u0435\u043b\u043e\u0441\u043d\u043e \u043f\u0440\u0438\u0441\u0443\u0441\u0442\u0432\u043e \u0432\u043e \u0441\u0435\u0433\u0430\u0448\u043d\u0438\u043e\u0442 \u043c\u043e\u043c\u0435\u043d\u0442. \u041d\u0430\u043c\u0435\u0441\u0442\u043e \u0434\u0430 \u0440\u0430\u0437\u043c\u0438\u0441\u043b\u0443\u0432\u0430\u043c\u0435 \u0437\u0430 \u043c\u0438\u043d\u0430\u0442\u043e\u0442\u043e \u0438\u043b\u0438 \u0434\u0430 \u0441\u0435 \u0433\u0440\u0438\u0436\u0438\u043c\u0435 \u0437\u0430 \u0438\u0434\u043d\u0438\u043d\u0430\u0442\u0430, \u0432\u043d\u0438\u043c\u0430\u043d\u0438\u0435\u0442\u043e \u0441\u0435 \u043d\u0430\u0441\u043e\u0447\u0443\u0432\u0430 \u043a\u043e\u043d \u043e\u043d\u0430 \u0448\u0442\u043e \u0441\u0435 \u0441\u043b\u0443\u0447\u0443\u0432\u0430 \u201e\u0441\u0435\u0433\u0430\u201c. \u0412\u0430\u0436\u043d\u043e \u0435 \u0448\u0442\u043e mindfulness \u043d\u0435 \u0437\u043d\u0430\u0447\u0438 \u0434\u0430 \u0441\u0435 \u201e\u0438\u0441\u0447\u0438\u0441\u0442\u0438\u201c \u0443\u043c\u043e\u0442 \u043e\u0434 \u043c\u0438\u0441\u043b\u0438, \u0442\u0443\u043a\u0443 \u0434\u0430 \u0441\u0435 \u043d\u0430\u0431\u0459\u0443\u0434\u0443\u0432\u0430\u0430\u0442 \u043c\u0438\u0441\u043b\u0438\u0442\u0435 \u0431\u0435\u0437 \u043e\u0441\u0443\u0434\u0443\u0432\u0430\u045a\u0435.",
        "videoUrl": "https://youtu.be/UQdG01wDrDI?si=1HkSquTwu4eaJMqn"
      },
      {
        "title": "\u0412\u0435\u0436\u0431\u0438 \u0437\u0430 \u0434\u0438\u0448\u0435\u045a\u0435",
        "description": "\u0414\u0438\u0448\u0435\u045a\u0435\u0442\u043e \u0435 \u0434\u0438\u0440\u0435\u043a\u0442\u043d\u043e \u043f\u043e\u0432\u0440\u0437\u0430\u043d\u043e \u0441\u043e \u043d\u0435\u0440\u0432\u043d\u0438\u043e\u0442 \u0441\u0438\u0441\u0442\u0435\u043c. \u041a\u043e\u0433\u0430 \u0441\u043c\u0435 \u043f\u043e\u0434 \u0441\u0442\u0440\u0435\u0441, \u0434\u0438\u0448\u0435\u045a\u0435\u0442\u043e \u0441\u0442\u0430\u043d\u0443\u0432\u0430 \u0431\u0440\u0437\u043e \u0438 \u043f\u043b\u0438\u0442\u043a\u043e. \u0421\u043e \u0441\u0432\u0435\u0441\u043d\u043e \u0443\u0441\u043f\u043e\u0440\u0443\u0432\u0430\u045a\u0435 \u043d\u0430 \u0434\u0438\u0448\u0435\u045a\u0435\u0442\u043e, \u0442\u0435\u043b\u043e\u0442\u043e \u0434\u043e\u0431\u0438\u0432\u0430 \u0441\u0438\u0433\u043d\u0430\u043b \u0434\u0435\u043a\u0430 \u0435 \u0431\u0435\u0437\u0431\u0435\u0434\u043d\u043e. \u041e\u0432\u0438\u0435 \u0442\u0435\u0445\u043d\u0438\u043a\u0438 \u043c\u043e\u0436\u0435 \u0434\u0430 \u0441\u0435 \u043a\u043e\u0440\u0438\u0441\u0442\u0430\u0442 \u0431\u0438\u043b\u043e \u043a\u043e\u0433\u0430 \u2013 \u043f\u0440\u0435\u0434 \u0438\u0441\u043f\u0438\u0442, \u0440\u0430\u0437\u0433\u043e\u0432\u043e\u0440 \u0438\u043b\u0438 \u0432\u043e \u0441\u0442\u0440\u0435\u0441\u043d\u0430 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0458\u0430.",
        "videoUrl": "https://youtu.be/Tb_ZfBLD3Jc?si=Ogo0lTUyqzaTTHuQ"
      },
      {
        "title": "\u0412\u0435\u0436\u0431\u0430 \u043d\u0430 \u0441\u0432\u0435\u0441\u043d\u043e\u0441\u0442",
        "description": "\u0412\u0435\u0436\u0431\u0438\u0442\u0435 \u043d\u0430 \u0441\u0432\u0435\u0441\u043d\u043e\u0441\u0442 \u0437\u043d\u0430\u0447\u0430\u0442 \u0434\u0430 \u043e\u0431\u0440\u043d\u0435\u043c\u0435 \u0432\u043d\u0438\u043c\u0430\u043d\u0438\u0435 \u043d\u0430 \u0442\u0435\u043a\u043e\u0432\u043d\u043e\u0442\u043e \u0438\u0441\u043a\u0443\u0441\u0442\u0432\u043e \u2013 \u0448\u0442\u043e \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0432\u0430\u043c\u0435, \u0448\u0442\u043e \u043c\u0438\u0441\u043b\u0438\u043c\u0435, \u0448\u0442\u043e \u0433\u043b\u0435\u0434\u0430\u043c\u0435 \u2013 \u0431\u0435\u0437 \u0434\u0430 \u0433\u043e \u043c\u0435\u043d\u0443\u0432\u0430\u043c\u0435. \u041e\u0432\u0430 \u0458\u0430 \u043d\u0430\u043c\u0430\u043b\u0443\u0432\u0430 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0441\u043a\u0430\u0442\u0430 \u0440\u0435\u0430\u043a\u0446\u0438\u0458\u0430, \u043f\u043e\u043c\u0430\u0433\u0430 \u0434\u0430 \u0441\u0435 \u0440\u0430\u0437\u0431\u0435\u0440\u0430\u0442 \u0441\u043e\u043f\u0441\u0442\u0432\u0435\u043d\u0438\u0442\u0435 \u0435\u043c\u043e\u0446\u0438\u0438 \u0438 \u0458\u0430 \u0437\u0433\u043e\u043b\u0435\u043c\u0443\u0432\u0430 \u043f\u0440\u0438\u0441\u0443\u0442\u043d\u043e\u0441\u0442\u0430.",
        "videoUrl": "https://youtu.be/wUqEocpDMu0?si=Z8cIRTHLLW4vameP"
      },
      {
        "title": "\u0410\u043d\u043a\u0441\u0438\u043e\u0437\u043d\u043e\u0441\u0442",
        "description": "\u0410\u043d\u043a\u0441\u0438\u043e\u0437\u043d\u043e\u0441\u0442\u0430 \u0435 \u043f\u0440\u0438\u0440\u043e\u0434\u043d\u0430 \u0440\u0435\u0430\u043a\u0446\u0438\u0458\u0430 \u043d\u0430 \u0442\u0435\u043b\u043e\u0442\u043e \u043d\u0430 \u043f\u043e\u0442\u0435\u043d\u0446\u0438\u0458\u0430\u043b\u043d\u0430 \u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442. \u0422\u0430\u0430 \u043d\u0438 \u043f\u043e\u043c\u0430\u0433\u0430 \u0434\u0430 \u0431\u0438\u0434\u0435\u043c\u0435 \u043f\u043e\u0434\u0433\u043e\u0442\u0432\u0435\u043d\u0438, \u043d\u043e \u043a\u043e\u0433\u0430 \u0435 \u043f\u0440\u0435\u0442\u0435\u0440\u0430\u043d\u0430 \u043c\u043e\u0436\u0435 \u0434\u0430 \u0441\u0442\u0430\u043d\u0435 \u043f\u0440\u043e\u0431\u043b\u0435\u043c. \u0410\u043d\u043a\u0441\u0438\u043e\u0437\u043d\u043e\u0441\u0442\u0430 \u043d\u0435 \u0435 \u0441\u043b\u0430\u0431\u043e\u0441\u0442 \u2013 \u0442\u043e\u0430 \u0435 \u043d\u043e\u0440\u043c\u0430\u043b\u0435\u043d \u043e\u0434\u0433\u043e\u0432\u043e\u0440 \u043d\u0430 \u0442\u0435\u043b\u043e\u0442\u043e. \u041f\u043e\u043c\u043e\u0448 \u043c\u043e\u0436\u0435 \u0434\u0430 \u0441\u0435 \u043d\u0430\u0458\u0434\u0435 \u043f\u0440\u0435\u043a\u0443 \u0442\u0435\u0445\u043d\u0438\u043a\u0438 \u043d\u0430 \u0434\u0438\u0448\u0435\u045a\u0435, \u0440\u0430\u0437\u0433\u043e\u0432\u043e\u0440 \u0441\u043e \u0434\u043e\u0432\u0435\u0440\u043b\u0438\u0432\u0430 \u043b\u0438\u0447\u043d\u043e\u0441\u0442 \u0438\u043b\u0438 \u043f\u0440\u043e\u0444\u0435\u0441\u0438\u043e\u043d\u0430\u043b\u043d\u0430 \u043f\u043e\u0434\u0434\u0440\u0448\u043a\u0430.",
