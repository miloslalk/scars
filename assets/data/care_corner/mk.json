      {
        "title": "\u0421\u043e\u0446\u0438\u0458\u0430\u043b\u043d\u0438 \u043f\u0440\u0430\u0432\u0430 \u043d\u0430 \u043c\u043b\u0430\u0434\u0438\u0442\u0435",
        "description": "\u041e\u0432\u0438\u0435 \u043f\u0440\u0430\u0432\u0430 \u0441\u0435 \u043e\u0441\u043d\u043e\u0432\u0430 \u0437\u0430 \u0434\u043e\u0441\u0442\u043e\u0438\u043d\u0441\u0442\u0432\u0435\u043d \u0436\u0438\u0432\u043e\u0442. \u0412\u043a\u043b\u0443\u0447\u0443\u0432\u0430\u0430\u0442: \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435, \u0440\u0430\u0431\u043e\u0442\u0430, \u0437\u0434\u0440\u0430\u0432\u0458\u0435, \u0434\u043e\u043c\u0443\u0432\u0430\u045a\u0435. \u0411\u0435\u0437 \u043d\u0438\u0432: \u0441\u0435 \u0437\u0433\u043e\u043b\u0435\u043c\u0443\u0432\u0430 \u043d\u0435\u0435\u0434\u043d\u0430\u043a\u0432\u043e\u0441\u0442\u0430.",
        "videos": []
