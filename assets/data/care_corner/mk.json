  "education": {
    "items": [
      {
        "title": "\u0428\u0442\u043e \u0435 \u0434\u0438\u0441\u043a\u0440\u0438\u043c\u0438\u043d\u0430\u0446\u0438\u0458\u0430?",
        "description": "\u0414\u0438\u0441\u043a\u0440\u0438\u043c\u0438\u043d\u0430\u0446\u0438\u0458\u0430\u0442\u0430 \u0437\u043d\u0430\u0447\u0438 \u043d\u0435\u0435\u0434\u043d\u0430\u043a\u0432\u043e \u0442\u0440\u0435\u0442\u0438\u0440\u0430\u045a\u0435 \u043d\u0430 \u043b\u0443\u0453\u0435 \u043f\u043e\u0440\u0430\u0434\u0438 \u043d\u0438\u0432\u043d\u0438 \u043b\u0438\u0447\u043d\u0438 \u043a\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043a\u0438. \u0422\u0430\u0430 \u043c\u043e\u0436\u0435 \u0434\u0430 \u0431\u0438\u0434\u0435 \u0434\u0438\u0440\u0435\u043a\u0442\u043d\u0430 (\u043e\u0442\u0432\u043e\u0440\u0435\u043d\u0430) \u0438\u043b\u0438 \u0438\u043d\u0434\u0438\u0440\u0435\u043a\u0442\u043d\u0430 (\u0441\u043a\u0440\u0438\u0435\u043d\u0430). \u041f\u043e\u0441\u043b\u0435\u0434\u0438\u0446\u0438: \u0438\u0441\u043a\u043b\u0443\u0447\u0435\u043d\u043e\u0441\u0442, \u043d\u0435\u0435\u0434\u043d\u0430\u043a\u0432\u0438 \u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0438, \u043f\u043e\u0432\u0440\u0435\u0434\u0430 \u043d\u0430 \u0434\u043e\u0441\u0442\u043e\u0438\u043d\u0441\u0442\u0432\u043e\u0442\u043e. \u041f\u0440\u0435\u043f\u043e\u0437\u043d\u0430\u0432\u0430\u045a\u0435\u0442\u043e \u0435 \u043f\u0440\u0432 \u0447\u0435\u043a\u043e\u0440 \u043a\u043e\u043d \u0441\u043f\u0440\u0435\u0447\u0443\u0432\u0430\u045a\u0435.",
        "videos": []
      },
      {
        "title": "\u0410\u043d\u0442\u0438\u0446\u0438\u0433\u0430\u043d\u0438\u0437\u0430\u043c",
        "description": "\u0410\u043d\u0442\u0438\u0446\u0438\u0433\u0430\u043d\u0438\u0437\u043c\u043e\u0442 \u0435 \u0434\u043b\u0430\u0431\u043e\u043a\u043e \u0432\u043a\u043e\u0440\u0435\u043d\u0435\u0442 \u043e\u0431\u043b\u0438\u043a \u043d\u0430 \u0434\u0438\u0441\u043a\u0440\u0438\u043c\u0438\u043d\u0430\u0446\u0438\u0458\u0430 \u043a\u043e\u043d \u0420\u043e\u043c\u0438\u0442\u0435. \u0422\u043e\u0458 \u043f\u043e\u0441\u0442\u043e\u0438 \u043d\u0435 \u0441\u0430\u043c\u043e \u043d\u0430 \u0438\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u043d\u043e, \u0442\u0443\u043a\u0443 \u0438 \u043d\u0430 \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u043e \u043d\u0438\u0432\u043e. \u0421\u0435 \u043f\u043e\u0458\u0430\u0432\u0443\u0432\u0430 \u043a\u0430\u043a\u043e: \u0441\u0442\u0435\u0440\u0435\u043e\u0442\u0438\u043f\u0438, \u0434\u0438\u0441\u043a\u0440\u0438\u043c\u0438\u043d\u0430\u0446\u0438\u0458\u0430, \u0441\u043e\u0446\u0438\u0458\u0430\u043b\u043d\u043e \u0438\u0441\u043a\u043b\u0443\u0447\u0443\u0432\u0430\u045a\u0435. \u041d\u0435 \u0435 \u043f\u0440\u043e\u0431\u043b\u0435\u043c \u043d\u0430 \u043f\u043e\u0435\u0434\u0438\u043d\u0446\u0438, \u0442\u0443\u043a\u0443 \u043d\u0430 \u043e\u043f\u0448\u0442\u0435\u0441\u0442\u0432\u043e\u0442\u043e.",
        "videos": []
      },
      {
        "title": "\u041a\u043e\u0438 \u0441\u0435 \u0420\u043e\u043c\u0438\u0442\u0435?",
        "description": "\u0420\u043e\u043c\u0438\u0442\u0435 \u0441\u0435 \u043d\u0430\u0440\u043e\u0434 \u0441\u043e \u0431\u043e\u0433\u0430\u0442\u0430 \u043a\u0443\u043b\u0442\u0443\u0440\u0430, \u0438\u0441\u0442\u043e\u0440\u0438\u0458\u0430 \u0438 \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u0458\u0430. \u0422\u0438\u0435 \u0441\u0435 \u0434\u0435\u043b \u043e\u0434 \u0435\u0432\u0440\u043e\u043f\u0441\u043a\u0430\u0442\u0430 \u0438\u0441\u0442\u043e\u0440\u0438\u0458\u0430 \u0438 \u0438\u043c\u0430\u0430\u0442 \u0437\u043d\u0430\u0447\u0430\u0435\u043d \u043a\u0443\u043b\u0442\u0443\u0440\u0435\u043d \u043f\u0440\u0438\u0434\u043e\u043d\u0435\u0441. \u0412\u0430\u0436\u043d\u043e \u0435 \u0434\u0430 \u0441\u0435 \u0433\u043b\u0435\u0434\u0430\u0430\u0442 \u043a\u0430\u043a\u043e \u0437\u0430\u0435\u0434\u043d\u0438\u0446\u0430 \u0441\u043e \u0438\u0434\u0435\u043d\u0442\u0438\u0442\u0435\u0442, \u043d\u0435 \u0441\u0430\u043c\u043e \u043d\u0438\u0437 \u043f\u0440\u0438\u0437\u043c\u0430 \u043d\u0430 \u0441\u043e\u0446\u0438\u0458\u0430\u043b\u043d\u0438 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0438.",
        "videos": []
