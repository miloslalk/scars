      {
        "title": "\u0423\u0437\u0435\u043c\u0458\u0443\u0432\u0430\u045a\u0435, \u0431\u0430\u043b\u0430\u043d\u0441 \u0438 \u0441\u0442\u0430\u0431\u0438\u043b\u043d\u043e\u0441\u0442",
        "description": "\u041a\u043e\u0433\u0430 \u0441\u043c\u0435 \u043f\u0440\u0435\u043e\u043f\u0442\u043e\u0432\u0430\u0440\u0435\u043d\u0438, \u043c\u043e\u0436\u0435 \u0434\u0430 \u0441\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0432\u0430\u043c\u0435 \u201e\u043e\u0434\u0432\u043e\u0435\u043d\u0438\u201c \u043e\u0434 \u0440\u0435\u0430\u043b\u043d\u043e\u0441\u0442\u0430. \u0422\u0435\u0445\u043d\u0438\u043a\u0438\u0442\u0435 \u0437\u0430 \u0443\u0437\u0435\u043c\u0458\u0443\u0432\u0430\u045a\u0435 \u043f\u043e\u043c\u0430\u0433\u0430\u0430\u0442 \u0434\u0430 \u0441\u0435 \u0432\u0440\u0430\u0442\u0438\u043c\u0435 \u0432\u043e \u0441\u0435\u0433\u0430\u0448\u043d\u0438\u043e\u0442 \u043c\u043e\u043c\u0435\u043d\u0442. \u041f\u0440\u0438\u043c\u0435\u0440\u0438: \u0438\u043c\u0435\u043d\u0443\u0432\u0430\u045a\u0435 5 \u0440\u0430\u0431\u043e\u0442\u0438 \u0448\u0442\u043e \u0433\u0438 \u0433\u043b\u0435\u0434\u0430\u0442\u0435, \u0444\u043e\u043a\u0443\u0441 \u043d\u0430 \u0441\u0442\u0430\u043f\u0430\u043b\u0430\u0442\u0430 \u043d\u0430 \u043f\u043e\u0434\u043e\u0442, \u0441\u043b\u0443\u0448\u0430\u045a\u0435 \u043d\u0430 \u0437\u0432\u0443\u0446\u0438\u0442\u0435 \u043e\u043a\u043e\u043b\u0443 \u0432\u0430\u0441. \u041e\u0432\u0430 \u043f\u043e\u043c\u0430\u0433\u0430 \u0437\u0430 \u0441\u043c\u0438\u0440\u0443\u0432\u0430\u045a\u0435 \u043d\u0430 \u0442\u0435\u043b\u043e\u0442\u043e, \u043d\u0430\u043c\u0430\u043b\u0443\u0432\u0430\u045a\u0435 \u043d\u0430 \u043f\u0430\u043d\u0438\u043a\u0430 \u0438 \u0437\u0433\u043e\u043b\u0435\u043c\u0443\u0432\u0430\u045a\u0435 \u043d\u0430 \u0447\u0443\u0432\u0441\u0442\u0432\u043e \u043d\u0430 \u0441\u0438\u0433\u0443\u0440\u043d\u043e\u0441\u0442.",
